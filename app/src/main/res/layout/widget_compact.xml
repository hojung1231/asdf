<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal">
<TextView android:id="@+id/brand" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="20dp" android:text="HUGGY 미니" android:textStyle="bold" android:letterSpacing="0.12" android:textSize="14sp" android:textColor="#69E8C0"/>
<TextView android:id="@+id/update" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingLeft="8dp" android:paddingRight="8dp" android:text="↑ 업데이트" android:textSize="11sp" android:textColor="#101317" android:backgroundTint="#69E8C0" android:background="@drawable/widget_button" android:visibility="gone"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal"><TextView android:id="@+id/metric0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="허기" android:textSize="12sp" android:textColor="#A6B0BB" android:background="@drawable/widget_button"/><TextView android:id="@+id/metric1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="집중력" android:textSize="12sp" android:textColor="#A6B0BB" android:background="@drawable/widget_button"/><TextView android:id="@+id/metric2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="스트레스" android:textSize="12sp" android:textColor="#A6B0BB" android:background="@drawable/widget_button"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="36dp">
<TextView android:id="@+id/current" android:maxLines="2" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="match_parent" android:textColor="#F0F3F5" android:textSize="12sp" android:gravity="center_vertical"/>
<TextView android:id="@+id/mean" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="match_parent" android:textColor="#B59AFF" android:textSize="11sp" android:gravity="center"/>
<TextView android:id="@+id/score" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textColor="#F0F3F5" android:textSize="11sp" android:gravity="center_vertical|right"/>
</LinearLayout>
<TextView android:id="@+id/weight" android:layout_width="match_parent" android:layout_height="28dp" android:background="@drawable/widget_button" android:gravity="center_vertical" android:paddingLeft="10dp" android:textSize="11sp" android:textColor="#E2E7EC"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<ImageView android:id="@+id/plot" android:layout_width="0dp" android:layout_weight="1.65" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="오늘의 허기 기록과 시간 누적 평균 그래프"/>
<LinearLayout android:id="@+id/friendPanel" android:visibility="gone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_button" android:padding="8dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="친구 소식 · 허기" android:textSize="10sp" android:textColor="#B59AFF"/>
<TextView android:id="@+id/friendMessage0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:padding="4dp" android:background="@drawable/friend_message" android:gravity="center_vertical" android:textSize="10sp" android:textColor="#E2E7EC" android:maxLines="3"/>
<TextView android:id="@+id/friendMessage1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:padding="4dp" android:background="@drawable/friend_message" android:gravity="center_vertical" android:textSize="10sp" android:textColor="#E2E7EC" android:maxLines="3"/>
<TextView android:id="@+id/friendMessage2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:padding="4dp" android:background="@drawable/friend_message" android:gravity="center_vertical" android:textSize="10sp" android:textColor="#E2E7EC" android:maxLines="3"/>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="함께 보기 ›" android:textSize="10sp" android:textColor="#A6B0BB"/>
</LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="16dp" android:text="━ 허기 기록    ━ 누적 평균    ▪ 목표 구간" android:textSize="10sp" android:textColor="#A6B0BB" android:id="@+id/legend"/>
<TextView android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" android:text="지금 몸의 신호는 어떤가요?" android:textSize="11sp" android:textColor="#A6B0BB"/>
<TextView android:id="@+id/b0" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E2E7EC" android:background="@drawable/button_full" android:maxLines="1"/>
<TextView android:id="@+id/b1" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E2E7EC" android:background="@drawable/button_full" android:maxLines="1"/>
<TextView android:id="@+id/b2" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E2E7EC" android:background="@drawable/button_full" android:maxLines="1"/>
<TextView android:id="@+id/b3" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E2E7EC" android:background="@drawable/button_hungry" android:maxLines="1"/>
<TextView android:id="@+id/b4" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E2E7EC" android:background="@drawable/button_hungry" android:maxLines="1"/>
<TextView android:id="@+id/b5" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E2E7EC" android:background="@drawable/button_hungry" android:maxLines="1"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="16dp" android:textColor="#8E9BA5" android:textSize="10sp" android:gravity="center_vertical"/>
</LinearLayout>
<ImageView android:id="@+id/effect" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
</FrameLayout>
