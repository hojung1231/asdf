<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090B13">
 <ImageView android:id="@+id/plot" android:layout_width="match_parent" android:layout_height="350dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="170dp" android:textColor="@android:color/transparent"/>
  <Button android:id="@+id/b0" android:layout_width="match_parent" android:layout_height="36dp" android:background="@android:color/transparent" android:textColor="@android:color/transparent"/>
<Button android:id="@+id/b1" android:layout_width="match_parent" android:layout_height="36dp" android:background="@android:color/transparent" android:textColor="@android:color/transparent"/>
<Button android:id="@+id/b2" android:layout_width="match_parent" android:layout_height="36dp" android:background="@android:color/transparent" android:textColor="@android:color/transparent"/>
<Button android:id="@+id/b3" android:layout_width="match_parent" android:layout_height="36dp" android:background="@android:color/transparent" android:textColor="@android:color/transparent"/>
<Button android:id="@+id/b4" android:layout_width="match_parent" android:layout_height="36dp" android:background="@android:color/transparent" android:textColor="@android:color/transparent"/>
 </LinearLayout>
</FrameLayout>
